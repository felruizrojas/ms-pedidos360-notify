# Copiar a .env (no se sube a git). En la EC2 lo genera CloudFormation.
# Local con RabbitMQ en el host (docker-compose.rabbitmq.yml de orders o infra/mq):
# desde el contenedor el host es host.docker.internal. Clúster de infra/mq: rabbit1 en 5672 y rabbit2 en 5673.
RABBIT_ADDRESSES=host.docker.internal:5672,host.docker.internal:5673
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
RABBIT_DECLARE_TOPOLOGY=true
# Modo demo (false): el email solo se registra en el log. true + perfil "mail": se envía a Mailpit.
# En la EC2 el perfil se activa con COMPOSE_PROFILES=mail (lo escribe CloudFormation).
MAIL_ENABLED=false
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pedidos360.cl
# Intentos locales antes del NACK a la DLQ (1 = sin reintento)
NOTIFY_MAX_INTENTOS=3
# false: los listeners de las DLQ no arrancan y los mensajes quedan visibles en la UI (demo)
NOTIFY_DLQ_LISTENERS=true
